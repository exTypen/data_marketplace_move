{
  "name": "campaign-manager-client",
  "version": "1.0.0",
  "description": "Campaign Manager Move modülü için TypeScript istemcisi",
  "main": "scripts/app.ts",
  "scripts": {
    "start": "ts-node scripts/main.ts",
    "node": "aptos node run-local-testnet --with-faucet",
    "build": "aptos move publish --profile devnet",
    "execute-project": "aptos move compile && npm run build && npm run start"
  },
  "dependencies": {
    "aptos": "^1.21.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
