{
  "name": "campaign-manager-client",
  "version": "1.0.0",
  "description": "Campaign Manager Move modülü için TypeScript istemcisi",
  "main": "scripts/app.ts",
  "scripts": {
    "start": "ts-node scripts/app.ts",
    "sign": "ts-node scripts/sign_test_data.ts",
    "node": "aptos node run-local-testnet --with-faucet",
    "build": "aptos move publish --profile default",
    "execute-project": "aptos move compile &&npm run build && npm run start"
  },
  "dependencies": {
    "@aptos-labs/aptos-client": "^1.0.0",
    "@noble/hashes": "^1.7.1",
    "aptos": "^1.21.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
